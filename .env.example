# .env.example — SOMENTE NOMES (ADR-0001 v2.0 D7). Repositório PÚBLICO: nenhum valor aqui.
# Copie para .env (fora do git) e preencha os valores locais combinados com o OPS (TASK-0012).
# Nenhum comportamento do contrato depende de ASPNETCORE_ENVIRONMENT (ADR-0001 v2.0 D7/D8);
# ela não é variável oficial. ASPNETCORE_URLS/--urls também não: o bind é feito no Program.cs.

# portal-api (provedor, ASP.NET Core)
PORTAL_API_HOST=
PORTAL_API_PORT=
PORTAL_API_ALLOWED_ORIGIN=
LOG_LEVEL=

# portal-web (consumidor, Angular)
PORTAL_WEB_PORT=
PORTAL_API_BASE_URL=
